# Streamlit Community Cloud → App settings → Secrets 貼上以下內容（改成自己的值）。
# 不要把真正的 secrets.toml 上傳到 GitHub。

# 雲端模式：停用「儲存到 .env」並提示資料會在重新啟動後清空
GNTC_CLOUD = "1"

# 選填：預設的 API Key。留空的話，使用者需在左側欄自行填寫（只在這次瀏覽中使用）
GOOGLE_API_KEY = ""
TAVILY_API_KEY = ""

# 選填：使用密碼。上面兩個金鑰留空時可以不設，任何人打開網址都能直接使用，但只能用自己的金鑰。
# 只要在上面填了金鑰，就一定要取消下一行的註解並設定密碼，否則任何拿到網址的人都會用掉你的 API 額度。
# APP_PASSWORD = "請改成一組只有你知道的密碼"
