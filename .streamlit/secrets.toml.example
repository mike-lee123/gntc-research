# Streamlit Community Cloud → App settings → Secrets 貼上以下內容（改成自己的值）。
# 不要把真正的 secrets.toml 上傳到 GitHub。

# 必填：公開網址任何人都能開啟，請設定使用密碼，避免別人用掉你的 API 額度
APP_PASSWORD = "請改成一組只有你知道的密碼"

# 雲端模式：停用「儲存到 .env」並提示資料會在重新啟動後清空
GNTC_CLOUD = "1"

# 選填：預設的 API Key。不填的話，使用者需在左側欄自行填寫
GOOGLE_API_KEY = ""
TAVILY_API_KEY = ""
